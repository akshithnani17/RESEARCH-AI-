# ResearchGap AI - Environment Configuration Example

# Backend Core
PROJECT_NAME="ResearchGap AI"
API_V1_STR=/api
SECRET_KEY=change_this_to_a_secure_random_string_in_production_environment_2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default is SQLite for zero-setup local development:
DATABASE_URL=sqlite:///./researchgap.db
# Or PostgreSQL with pgvector:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchgap_ai

# AI / LLM Configuration
# Options: "openai_compatible" (with OpenAI / Gemini / Ollama / DeepSeek) or "offline_heuristic"
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Uploads & Constraints
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=30
MIN_PAPERS_REQUIRED=5

# Frontend Environment Variables (in frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000/api
